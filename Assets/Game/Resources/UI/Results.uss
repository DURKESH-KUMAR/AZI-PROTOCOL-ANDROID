/* Results screen. */

.results {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding-top: 30px;
}

.results__banner {
    font-size: 112px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    opacity: 0;
    scale: 1.8 1.8;
    transition-property: opacity, scale;
    transition-duration: 0.4s, 0.5s;
    transition-timing-function: ease-out, ease-out-back;
}

.results__banner--in {
    opacity: 1;
    scale: 1 1;
}

.results__reason {
    font-size: 30px;
    color: var(--muted);
    margin-bottom: 14px;
}

.results__line {
    width: 1500px;
    height: 3px;
    margin-bottom: 10px;
}

.score-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

.score {
    width: 400px;
    align-items: center;
}

.score__label {
    font-size: 34px;
}

.score__value {
    font-size: 104px;
}

.score--lost {
    opacity: 0.55;
}

.score__dash {
    font-size: 80px;
    color: var(--muted);
    width: 100px;
    -unity-text-align: middle-center;
}

.rosters {
    width: 100%;
    flex-direction: row;
    justify-content: center;
}

.roster {
    width: 44%;
    max-width: 820px;
    margin: 0 30px;
    padding-bottom: 12px;
    background-color: var(--panel);
    border-top-width: 5px;
    border-radius: 4px;
}

.roster--blue {
    border-top-color: var(--blue);
}

.roster--red {
    border-top-color: var(--red);
}

.result-row {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 20px;
    opacity: 0;
    translate: 0 12px;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.25s;
}

.result-row--in {
    opacity: 1;
    translate: 0 0;
}

.result-row--header {
    opacity: 1;
    translate: 0 0;
    height: 56px;
}

.result-row--header Label {
    color: var(--muted);
    font-size: 24px;
}

.result-row--you {
    background-color: rgba(255, 184, 48, 0.15);
}

.result-row__name {
    flex-grow: 1;
    font-size: 30px;
}

.result-row__stat {
    width: 100px;
    font-size: 30px;
    -unity-text-align: middle-center;
}

.results__empty {
    font-size: 28px;
    color: var(--muted);
    -unity-text-align: middle-center;
    height: 54px;
}

.results__you {
    position: absolute;
    bottom: 175px;
    font-size: 34px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.results__you--in {
    opacity: 1;
}

.results__buttons {
    position: absolute;
    bottom: 50px;
    flex-direction: row;
}

.results__buttons .btn {
    width: 460px;
    height: 100px;
    margin: 0 20px;
}
