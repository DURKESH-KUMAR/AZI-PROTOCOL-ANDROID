/* In-match HUD. Everything is touch-transparent except buttons (set in code). */

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* ------------------------------------------------------------ crosshair feedback */

.hitmarker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 0.12s, 0.12s;
}

.hitmarker--show {
    opacity: 1;
    transition-duration: 0s, 0s;
}

.hitmarker--kill {
    scale: 1.4 1.4;
}

.hitmarker__line {
    position: absolute;
    width: 22px;
    height: 4px;
    margin-left: -11px;
    margin-top: -2px;
    background-color: #FFFFFF;
}

.hitmarker--kill .hitmarker__line {
    background-color: var(--red);
}

.damage-arrow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150px;
    height: 14px;
    margin-left: -75px;
    margin-top: -7px;
    background-color: rgba(255, 51, 38, 1);
    border-radius: 7px;
    opacity: 0;
}

.spawn {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% 70px;
    font-size: 26px;
    color: #80E6FF;
}

/* ------------------------------------------------------------ call-outs */

.callout {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -330px;
    width: 1000px;
    align-items: center;
    opacity: 0;
    scale: 1.3 1.3;
    transition-property: opacity, scale;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out, ease-out-back;
}

.callout--show {
    opacity: 1;
    scale: 1 1;
    transition-duration: 0.12s, 0.25s;
}

.callout__title {
    font-size: 50px;
    letter-spacing: 3px;
    color: var(--accent);
}

.callout__sub {
    font-size: 30px;
}

.warmup {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -260px;
    width: 1200px;
    font-size: 52px;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.warmup--pulse {
    scale: 1.15 1.15;
    transition-duration: 0s;
}

/* ------------------------------------------------------------ weapon */

.ammo {
    position: absolute;
    bottom: 72px; /* sits on top of the health bar (Controls.uss) */
    left: 50%;
    translate: -50% 0;
    width: 260px;
    height: 74px;
    justify-content: center;
}

.ammo__count {
    font-size: 40px;
    -unity-text-align: middle-center;
}

.ammo__count--low {
    color: #FFBF4D;
}

.ammo__count--empty {
    color: var(--red);
}

.reload {
    position: absolute;
    bottom: 156px;
    left: 50%;
    translate: -50% 0;
    width: 260px;
    align-items: center;
}

.reload__label {
    font-size: 24px;
    color: var(--accent);
    margin-bottom: 4px;
}

.reload__label--empty {
    color: var(--red);
}

.reload__track {
    width: 260px;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    overflow: hidden;
}

.reload__fill {
    height: 100%;
    width: 0;
    background-color: var(--accent);
}

/* ------------------------------------------------------------ kill feed */

.killfeed {
    position: absolute;
    top: 175px; /* below the scene home button */
    right: 24px;
    width: 620px;
    align-items: flex-end;
}

.feed-row {
    height: 46px;
    margin-bottom: 6px;
    padding: 0 16px;
    background-color: var(--panel);
    border-radius: 4px;
    font-size: 24px;
    -unity-text-align: middle-right;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.6s, 0.2s;
}

.feed-row--new {
    opacity: 0;
    translate: 60px 0;
}

.feed-row--mine {
    background-color: rgba(255, 184, 48, 0.28);
}

.feed-row--fade {
    opacity: 0;
}

/* ------------------------------------------------------------ radar */

.radar {
    position: absolute;
    top: 120px;
    left: 24px;
    width: 230px;
    height: 230px;
    background-color: rgba(5, 13, 20, 0.55);
    border-top-width: 3px;
    border-top-color: var(--accent);
    border-radius: 4px;
    overflow: hidden;
}

.radar__line-h {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.12);
}

.radar__line-v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.12);
}

.radar__self {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    border-radius: 7px;
    background-color: var(--accent);
}

.radar__self-dir {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 18px;
    margin-left: -2px;
    margin-top: -24px;
    background-color: var(--accent);
}

.radar__dot {
    position: absolute;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
    border-radius: 6px;
}

/* ------------------------------------------------------------ pause button */

.pause-button {
    position: absolute;
    top: 20px;
    left: 24px;
    width: 96px;
    height: 96px;
    margin: 0;
    font-size: 34px;
    background-color: var(--panel);
}

/* ------------------------------------------------------------ death / banner */

.death {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(64, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.death__title {
    font-size: 50px;
    color: var(--red);
}

.death__timer {
    font-size: 34px;
    margin-top: 16px;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 300px;
    translate: 0 -150px;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 1.3 1.3;
    transition-property: opacity, scale;
    transition-duration: 0.3s, 0.45s;
    transition-timing-function: ease-out, ease-out-back;
}

.banner--show {
    opacity: 1;
    scale: 1 1;
}

.banner__title {
    font-size: 96px;
    letter-spacing: 6px;
}

.banner__sub {
    font-size: 38px;
    -unity-text-align: middle-center;
}

.pause__hint {
    font-size: 26px;
    color: var(--muted);
    margin-bottom: 40px;
}
